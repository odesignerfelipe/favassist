# Cole no Easypanel → (serviço Compose) → Environment, com "Create .env file" ATIVADO.
# Substitua os valores entre < >. NÃO coloque estes valores no GitHub.
APP_URL=https://assistente.favisdesign.com.br
COOKIE_SECURE=true
LOG_LEVEL=info

# Supabase → Connect → Session pooler (porta 5432). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=<postgresql://postgres.mbctlwobwwpgzsusnovg:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres>
DATABASE_SSL=true

AUTH_PROVIDER=supabase
SUPABASE_URL=https://mbctlwobwwpgzsusnovg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7Nn2ic20BivRRND3QUmnAA_XaEirzom
SUPABASE_SECRET_KEY=<sb_secret_...>

AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
MESSAGING_PROVIDER=simulator

# Fotos e vídeos das evidências: Supabase Storage (bucket privado criado automaticamente)
STORAGE_BUCKET=evidencias
UPLOAD_MAX_MB=50

# Primeiro Administrador FAVIS (criado na implantação). Após o primeiro acesso, apague SEED_ADMIN_PASSWORD e reimplante.
SEED_ADMIN_EMAIL=<seu-email>
SEED_ADMIN_PASSWORD=<senha com 10+ caracteres>
SEED_ADMIN_NAME=Administrador FAVIS
