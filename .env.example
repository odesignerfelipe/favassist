# =============================================================
# FAV Assist — variáveis de ambiente (EXEMPLO)
# Copie para `.env` na raiz e ajuste. NUNCA comite o arquivo .env.
# =============================================================

# ---------- Geral ----------
NODE_ENV=development
# URL pública do front-end (CORS e links nas mensagens)
APP_URL=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=3333
LOG_LEVEL=info

# ---------- Banco de dados ----------
# Postgres local (docker compose) ou conexão direta do Supabase
# (Supabase: Project Settings → Database → Connection string, modo "session"/direto, porta 5432)
DATABASE_URL=postgres://fav:troque-esta-senha@localhost:5432/fav_assist
# Banco usado pelos testes automatizados (será limpo pelos testes!)
TEST_DATABASE_URL=postgres://fav:troque-esta-senha@localhost:5432/fav_assist_test
# true quando o banco exigir SSL (Supabase em produção)
DATABASE_SSL=false

# ---------- Autenticação ----------
# local    → a API emite tokens (desenvolvimento/VPS sem Supabase)
# supabase → Supabase Auth (produção recomendada)
AUTH_PROVIDER=local
# Segredo HS256 do modo local (mínimo 32 caracteres). Gere com: openssl rand -base64 48
AUTH_JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Duração do token de acesso (segundos) e do refresh token (dias) — modo local
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=14
# Cookie de sessão com flag Secure (padrão: true em produção). Só use false sem HTTPS.
COOKIE_SECURE=

# ---------- Docker Compose ----------
POSTGRES_USER=fav
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fav_assist
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# ---------- Supabase (somente se AUTH_PROVIDER=supabase) ----------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chaves novas (recomendado): Project Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: SOMENTE no servidor. Nunca no front-end nem no GitHub.
SUPABASE_SECRET_KEY=
# Alternativa com chaves legadas (JWT): SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# Opcional: segredo JWT legado (HS256). Se vazio, a API valida os tokens pelo JWKS do projeto.
SUPABASE_JWT_SECRET=

# ---------- Produção (docker-compose.prod.yml) ----------
DOMAIN=asistente.favisdesign.com.br

# ---------- Primeiro administrador (script db:seed:admin) ----------
SEED_ADMIN_EMAIL=admin@favis.com.br
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador FAVIS

# ---------- Redis / filas ----------
# Vazio = sem filas: IA roda no próprio processo da API e envios diários ficam manuais.
REDIS_URL=redis://localhost:6379

# ---------- Inteligência artificial ----------
# none | anthropic   (novos provedores entram implementando AIProvider em packages/ai-engine)
AI_PROVIDER=none
# Vazio = modelo padrão do provedor (anthropic: claude-opus-5-5)
AI_MODEL=
# Chave da API do provedor. SOMENTE no servidor.
AI_API_KEY=
AI_TIMEOUT_MS=600000

# ---------- Mensageria / WhatsApp ----------
# simulator é a única opção nesta etapa (nenhum número real é conectado)
MESSAGING_PROVIDER=simulator
# Taxa de falha artificial do simulador (0 a 1) para testar tratamento de erros
SIMULATOR_FAILURE_RATE=0
MESSAGING_MAX_ATTEMPTS=3

# ---------- Front-end (Vite) ----------
# Prefixo da API vista pelo navegador. Em dev o Vite faz proxy de /api para a API.
VITE_API_URL=/api
